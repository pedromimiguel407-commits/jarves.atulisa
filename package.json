{
  "name": "jarves-ai",
  "version": "2.3.7",
  "description": "JARVES AI multiplataforma: FastAPI, Ollama local, cliente Android e desktop",
  "type": "module",
  "main": "desktop/main.cjs",
  "desktopName": "JARVES AI",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "dotenv": "^16.4.5",
    "express": "^5.0.0"
  },
  "productName": "JARVES AI",
  "author": {
    "name": "JARVES AI",
    "email": "jarves-ai@example.com"
  },
  "license": "UNLICENSED",
  "homepage": "https://github.com/pedromimiguel407-commits/jarve-apk-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/pedromimiguel407-commits/jarve-apk-2.0.git"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "desktop": "electron .",
    "build:windows": "node scripts/build-desktop.mjs --win nsis",
    "build:linux": "node scripts/build-desktop.mjs --linux AppImage",
    "check": "node scripts/check.mjs",
    "lint": "node scripts/check.mjs",
    "test": "node scripts/test.mjs"
  },
  "build": {
    "appId": "com.jarves.ai",
    "productName": "JARVES AI",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/backend",
        "to": "backend",
        "filter": [
          "JARVESBackend*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "JARVES-AI-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "frontend/assets/icon-512.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "JARVES-AI-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
